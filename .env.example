# Copia este fichero a .env y rellena los valores. .env no se versiona.

# Proyecto de Microsoft Foundry (Responses API). Formato: https://<recurso>.services.ai.azure.com/api/projects/<proyecto>
FOUNDRY_PROJECT_ENDPOINT=
# Despliegue del modelo. Por defecto gpt-5.4; alternativa gpt-5.4-mini.
FOUNDRY_MODEL=gpt-5.4

# En local, DefaultAzureCredential se salta la sonda de identidad administrada (PLAN.md §5.6).
AZURE_TOKEN_CREDENTIALS=dev

# Telemetría: solo se activa si esta variable existe. scripts/aspire.sh levanta el dashboard en :18888 con OTLP en :4317.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Captura el contenido de prompts y respuestas en las trazas (solo para depurar).
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# Hosted Agent (step-7). Registro de contenedores (nombre, sin .azurecr.io) para scripts/deploy-hosted.sh.
# UPGRADE_CAPTAIN_ACR=
# Nombre del agente en Foundry. Por defecto upgrade-captain.
# UPGRADE_CAPTAIN_AGENT_NAME=upgrade-captain
# Solo si el endpoint del agente no es <FOUNDRY_PROJECT_ENDPOINT>/agents/<nombre>/endpoint/protocols (scripts/hosted.sh).
# UPGRADE_CAPTAIN_HOSTED_ENDPOINT=
# Tope de tokens por sesión de BudgetGuard (step-6). Por defecto 1.500.000.
# UPGRADE_CAPTAIN_TOKEN_BUDGET=1500000
