<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Teide.Geo 1.8.0 — librería ficticia para la demo de Upgrade Captain.
    Esta versión está afectada por el aviso TEIDE-2026-0042 (ReDoS en GeoFormat.Parse).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Teide.Geo</RootNamespace>

    <PackageId>Teide.Geo</PackageId>
    <Version>1.8.0</Version>
    <Authors>Teide Labs</Authors>
    <Description>Cálculos geográficos para las Islas Canarias: distancias, rumbos, elevaciones y formato DMS.</Description>
    <PackageTags>geo;canarias;haversine</PackageTags>
    <PackageReadmeFile>RELEASE-NOTES.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Paquete reproducible: mismo contenido en cada pack-feed.sh -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Include="RELEASE-NOTES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
