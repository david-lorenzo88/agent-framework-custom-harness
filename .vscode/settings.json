{
  // Legibilidad en el escenario (PLAN.md §5.9): 20 pt en editor y terminal.
  "editor.fontSize": 20,
  "terminal.integrated.fontSize": 20,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "none",
  "workbench.startupEditor": "none",
  "files.exclude": {
    "**/bin": true,
    "**/obj": true,
    ".ref": true
  },
  "search.exclude": {
    ".ref": true,
    "demo-workspace": true,
    "out": true
  }
}
