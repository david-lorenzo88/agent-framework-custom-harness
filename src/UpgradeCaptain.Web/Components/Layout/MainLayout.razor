@inherits LayoutComponentBase
@implements IDisposable
@inject Cockpit Cockpit
@inject NavigationManager Nav

<div class="shell @(this.IsOwnerWindow ? "owner-window" : string.Empty)" style="--scale:@this.Cockpit.FontScale.ToString(System.Globalization.CultureInfo.InvariantCulture)">
    <header class="topbar">
        <a class="brand" href="/" title="Upgrade Captain">
            <span class="brand-mark">⎈</span>
            <span class="brand-text">UPGRADE<b>CAPTAIN</b></span>
        </a>

        @if (!this.IsOwnerWindow)
        {
            <nav class="steps-nav">
                @foreach (var (href, number, label) in this.Nav_Items)
                {
                    <a class="step-chip @(this.IsActive(href) ? "active" : string.Empty)" href="@href">
                        <span class="step-num">@number</span><span class="step-label">@label</span>
                    </a>
                }
            </nav>

            <a id="nav-prev" class="sr-only" href="@this.Neighbour(-1)">prev</a>
            <a id="nav-next" class="sr-only" href="@this.Neighbour(+1)">next</a>
        }
        else
        {
            <div class="owner-title">@this.Cockpit.T("Portátil de María · @maria-payments", "María's laptop · @maria-payments")</div>
        }

        <div class="topbar-right">
            @if (!this.IsOwnerWindow)
            {
                <ClockChip />
                <AgentPill />
                <a class="pill pill-link" href="/maria" target="maria" title="@this.Cockpit.T("Abre la ventana de María (propietaria de Payments)", "Open María's window (Payments owner)")">
                    👩‍💻 María ↗
                </a>
            }

            <div class="lang-toggle" role="group" aria-label="language">
                <button id="lang-en" class="@(this.Cockpit.Language == DemoLanguage.En ? "on" : string.Empty)" @onclick="() => this.SetLanguage(DemoLanguage.En)">EN</button>
                <button id="lang-es" class="@(this.Cockpit.Language == DemoLanguage.Es ? "on" : string.Empty)" @onclick="() => this.SetLanguage(DemoLanguage.Es)">ES</button>
            </div>
            <div class="zoom" role="group" aria-label="font size">
                <button title="A−" @onclick="() => this.Zoom(-0.1)">A−</button>
                <button title="A+" @onclick="() => this.Zoom(+0.1)">A+</button>
            </div>
        </div>
    </header>

    @if (this.Cockpit.Operation is { } operation)
    {
        <div class="operation-banner"><span class="spinner tiny"></span>@operation</div>
    }

    @if (this.IsOwnerWindow)
    {
        <main class="content solo">
            @Body
        </main>
    }
    else
    {
        @* El chat va siempre a la derecha y a toda altura; el contenido del paso, en pestañas a la izquierda. *@
        <div class="workspace chat-@this.Cockpit.ChatWidth">
            <main class="content">
                @Body
            </main>
            <ChatDock />
        </div>
    }
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool IsOwnerWindow => this.Nav.ToBaseRelativePath(this.Nav.Uri).StartsWith("maria", StringComparison.Ordinal);

    private IEnumerable<(string Href, string Number, string Label)> Nav_Items =>
    [
        ("/", "0", this.Cockpit.T("Apertura", "Opening")),
        ("/step/1", "1", "Harness"),
        ("/step/2", "2", "Approve"),
        ("/step/3", "3", this.Cockpit.T("Tu harness", "Your harness")),
        ("/step/4", "4", "Hosted"),
        ("/close", "✦", this.Cockpit.T("Cierre", "Close")),
    ];

    private string Path => "/" + this.Nav.ToBaseRelativePath(this.Nav.Uri).Split('?', '#')[0];

    private bool IsActive(string href) => href == "/" ? this.Path == "/" : this.Path.StartsWith(href, StringComparison.Ordinal);

    private string Neighbour(int delta)
    {
        var items = this.Nav_Items.Select(i => i.Href).ToList();
        int index = items.FindIndex(this.IsActive);
        return items[Math.Clamp((index < 0 ? 0 : index) + delta, 0, items.Count - 1)];
    }

    protected override void OnInitialized()
    {
        this.Cockpit.Changed += this.OnChanged;
        this.Nav.LocationChanged += this.OnLocationChanged;
    }

    private void OnChanged() => _ = this.InvokeAsync(this.StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => _ = this.InvokeAsync(this.StateHasChanged);

    private async Task SetLanguage(DemoLanguage language) => await this.Cockpit.SetLanguageAsync(language);

    private void Zoom(double delta)
    {
        this.Cockpit.FontScale = Math.Clamp(Math.Round(this.Cockpit.FontScale + delta, 1), 0.7, 1.8);
        this.Cockpit.NotifyNow();
    }

    public void Dispose()
    {
        this.Cockpit.Changed -= this.OnChanged;
        this.Nav.LocationChanged -= this.OnLocationChanged;
    }
}
