@inherits CockpitBase

@* Los fragmentos de código de un paso, en pestañas. *@
<section class="snippets">
    <nav class="tabs">
        @foreach (SnippetRef snippet in this.Items)
        {
            <button class="tab @(snippet.Id == this.Selected ? "active" : string.Empty)" @onclick="() => this.Select(snippet.Id)">@T(snippet.Title)</button>
        }
    </nav>
    @if (this.Items.FirstOrDefault(s => s.Id == this.Selected) is { } current)
    {
        <CodeView Id="@current.Id" Note="@T(current.Note)" Reveal="@(this.RevealId == current.Id)" />
    }
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SnippetRef> Items { get; set; } = [];

    [Parameter]
    public string? Selected { get; set; }

    [Parameter]
    public EventCallback<string> SelectedChanged { get; set; }

    /// <summary>El fragmento que se «teclea» al enseñarlo (el evaluador en el step-3b).</summary>
    [Parameter]
    public string? RevealId { get; set; }

    protected override void OnParametersSet()
    {
        if (this.Selected is null || this.Items.All(s => s.Id != this.Selected))
        {
            this.Selected = this.Items.FirstOrDefault()?.Id;
        }
    }

    private async Task Select(string id)
    {
        this.Selected = id;
        await this.SelectedChanged.InvokeAsync(id);
    }
}
