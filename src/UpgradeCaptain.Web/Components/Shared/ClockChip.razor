@inherits CockpitBase

@* El reloj de la charla: tiempo transcurrido y la sección del guion en la que deberías estar. *@
<div class="clock @(this.Cockpit.Clock.Running ? "running" : "paused") @this.Tone">
    <button id="clock-toggle" class="clock-time" title="@T("Arrancar / pausar (T)", "Start / pause (T)")" @onclick="this.Toggle">
        <span class="clock-icon">@(this.Cockpit.Clock.Running ? "⏱" : "⏸")</span>@this.Format(this.Cockpit.Clock.Elapsed)<small>/50:00</small>
    </button>
    <span class="clock-section">@T(this.Section.Title)</span>
    <button class="clock-reset" title="@T("Poner a cero", "Reset")" @onclick="this.Reset">↺</button>
</div>

@code {
    private PeriodicTimer? _tick;

    private (Bi Title, TimeSpan Start, int Minutes) Section =>
        StepCatalog.Agenda.LastOrDefault(s => s.Start <= this.Cockpit.Clock.Elapsed, StepCatalog.Agenda[0]);

    private string Tone => this.Cockpit.Clock.Elapsed > StepCatalog.TalkLength ? "over"
        : this.Cockpit.Clock.Elapsed > StepCatalog.TalkLength - TimeSpan.FromMinutes(5) ? "late" : string.Empty;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this._tick = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = this.TickAsync();
    }

    private async Task TickAsync()
    {
        try
        {
            while (this._tick is not null && await this._tick.WaitForNextTickAsync())
            {
                if (this.Cockpit.Clock.Running)
                {
                    await this.InvokeAsync(this.StateHasChanged);
                }
            }
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private string Format(TimeSpan t) => $"{(int)t.TotalMinutes:00}:{t.Seconds:00}";

    private void Toggle()
    {
        this.Cockpit.Clock.Toggle();
        this.Cockpit.NotifyNow();
    }

    private void Reset()
    {
        this.Cockpit.Clock.Reset();
        this.Cockpit.NotifyNow();
    }

    public override void Dispose()
    {
        this._tick?.Dispose();
        this._tick = null;
        base.Dispose();
    }
}
