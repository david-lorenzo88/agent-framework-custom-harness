@inherits CockpitBase

@* step-4 · el Hosted Agent por el protocolo Invocations (scripts/hosted.sh en C#). Solo llama al pulsar un botón. *@
@{
    HostedClient hosted = this.Cockpit.Hosted;
    HostedJobStatus? status = hosted.Last;
}
<section class="hosted panel">
    <header class="panel-head">
        <h3>☁️ Hosted Agent <small>Invocations · @hosted.JobId</small></h3>
        <div class="mode-toggle" role="group" aria-label="target">
            <button class="@(!hosted.Local ? "on" : string.Empty)" @onclick="() => this.SetLocal(false)">Foundry</button>
            <button class="@(hosted.Local ? "on" : string.Empty)" @onclick="() => this.SetLocal(true)">local :8088</button>
        </div>
    </header>

    <dl class="kv">
        <dt>endpoint</dt><dd><code>@(hosted.Endpoint ?? T("sin configurar", "not configured"))</code></dd>
        <dt>agent_session_id</dt><dd><code>@(hosted.SessionId ?? T("ninguna: lanza el trabajo", "none: trigger the job"))</code></dd>
    </dl>

    <div class="actions">
        <button class="btn" disabled="@hosted.Busy" @onclick="hosted.StatusAsync">job.status</button>
        <button class="btn @(hosted.Watching ? "btn-stop" : "btn-ghost")" @onclick="hosted.ToggleWatch">@(hosted.Watching ? "⏹ " + T("Dejar de vigilar", "Stop watching") : "👁 " + T("Vigilar (5 s)", "Watch (5 s)"))</button>
        @if (this._confirmTrigger)
        {
            <span class="confirm">
                @T("¿Lanzar un trabajo NUEVO (sesión nueva)? Hazlo ≥ 30 min antes.", "Trigger a NEW job (new session)? Do it ≥ 30 min before.")
                <button class="btn btn-go small" @onclick="this.TriggerAsync">@T("Sí, lanzar", "Yes, trigger")</button>
                <button class="btn btn-ghost small" @onclick="() => this._confirmTrigger = false">@T("No", "No")</button>
            </span>
        }
        else
        {
            <button class="btn btn-ghost" disabled="@hosted.Busy" @onclick="() => this._confirmTrigger = true">🚀 upgrade.requested</button>
        }
        @if (hosted.Busy)
        {
            <span class="spinner"></span>
        }
    </div>

    @if (status is not null)
    {
        <div class="job-status status-@status.Status pop" @key="status">
            <div class="job-status-main">
                <span class="status-pill">@status.Status</span>
                @if (status.LastVerification is { } verification)
                {
                    <span class="muted">@verification</span>
                }
                @if (status.ReportPath is { } report)
                {
                    <span class="badge">📄 @report</span>
                }
            </div>
            @if (status.Message is { } message)
            {
                <p class="muted small">@message</p>
            }

            @foreach (HostedApproval approval in status.PendingApprovals ?? [])
            {
                <article class="card owner-card pending" @key="approval.Id">
                    <header>
                        <span class="card-icon">⏸</span>
                        <span class="card-title">@approval.Id</span>
                        <code class="tool-summary">@approval.Tool · @string.Join(", ", approval.Paths)</code>
                        <span class="badge">@T("propietario", "owner"): @string.Join(", ", approval.Owners)</span>
                        <span class="badge badge-dim">@T("pide", "requested by"): @approval.RequestedBy</span>
                    </header>
                    <div class="actions">
                        <input class="input" @bind="this._reason" @bind:event="oninput" />
                        <button class="btn btn-go" disabled="@hosted.Busy" @onclick="() => hosted.DecideAsync(approval.Id, this._as, true, this._reason)">✅ @T("Aprobar como", "Approve as") @this._as</button>
                        <button class="btn btn-stop" disabled="@hosted.Busy" @onclick="() => hosted.DecideAsync(approval.Id, this._as, false, this._reason)">✋ @T("Rechazar", "Reject")</button>
                        <select class="input narrow" @bind="this._as">
                            <option>@("@maria-payments")</option>
                            <option>@("@david-lorenzo")</option>
                        </select>
                    </div>
                </article>
            }
        </div>
    }

    @if (hosted.Error is { } error)
    {
        <div class="notice notice-error">@error</div>
    }

    @if (hosted.Calls.Count > 0)
    {
        <details class="calls">
            <summary>@T("Llamadas", "Calls") (@hosted.Calls.Count)</summary>
            @foreach (HostedCall call in hosted.Calls)
            {
                <div class="call @(call.Ok ? "ok" : "bad")">
                    <div class="call-head"><code>@call.Event</code> <span>HTTP @(call.Http?.ToString() ?? "—")</span> <span class="muted">@call.At.ToString("HH:mm:ss")</span></div>
                    <pre>@call.Body</pre>
                </div>
            }
        </details>
    }
</section>

@code {
    private bool _confirmTrigger;
    private string _as = "@maria-payments";
    private string _reason = string.Empty;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this._reason = T("Revisado: tarifa en km", "Reviewed: fare in km");
    }

    private void SetLocal(bool local)
    {
        this.Cockpit.Hosted.Local = local;
        this.Cockpit.NotifyNow();
    }

    private async Task TriggerAsync()
    {
        this._confirmTrigger = false;
        await this.Cockpit.Hosted.TriggerAsync();
    }
}
