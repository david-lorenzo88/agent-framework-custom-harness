@inherits CockpitBase

@* Un fragmento de código real con los comentarios en el idioma de la charla. Reveal = se «teclea» línea a línea. *@
@{ this.EnsureLoaded(); }
@if (this._snippet is { } snippet)
{
    <figure class="code-view @(this.Reveal ? "revealing" : string.Empty) @(this.Compact ? "compact" : string.Empty)" @key="this._key">
        <figcaption>
            <span class="code-source">
                @if (this.Tag is { } tag)
                {
                    <span class="tag-badge">@tag</span>
                }
                @if (this.Href is { } href)
                {
                    <a href="@href" title="@T("Abrir en VS Code", "Open in VS Code")">@this.FilePath</a>
                }
                else
                {
                    <span>@this.FilePath</span>
                }
            </span>
            @if (this.Note is { } note)
            {
                <span class="code-note">@note</span>
            }
        </figcaption>
        <pre class="code lang-@snippet.Kind"><code>@foreach (CodeLine line in snippet.Lines)
{<span class="line @(line.Emphasis ? "em" : string.Empty) @(line.Comment ? "is-comment" : string.Empty)" style="--i:@line.Number"><span class="ln">@line.Number</span><span class="lc">@line.Html</span></span>
}</code></pre>
    </figure>
}

@code {
    private Snippet? _snippet;
    private string _key = string.Empty;
    private (string, DemoLanguage, bool) _loaded;

    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter]
    public bool Reveal { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public string? Note { get; set; }

    private string? Tag => this._snippet?.Source.Contains(':') == true ? this._snippet.Source.Split(':')[0] : null;

    private string FilePath => this._snippet?.Source.Split(':').Last() ?? string.Empty;

    /// <summary>Ficheros de main: enlace vscode:// para abrirlos en el editor (las tags no existen en disco).</summary>
    private string? Href => this.Tag is null && this._snippet is not null && !this._snippet.Source.StartsWith('?')
        ? $"vscode://file/{Path.Combine(this.Cockpit.Paths.ProjectRoot, this.FilePath)}"
        : null;

    // Al cambiar el idioma la cabina repinta sin parámetros nuevos: se comprueba en cada render.
    private void EnsureLoaded()
    {
        if (this._loaded != (this.Id, this.Lang, this.Reveal))
        {
            this._snippet = Snippets.Load(this.Id, this.Lang);
            this._loaded = (this.Id, this.Lang, this.Reveal);
            this._key = $"{this.Id}-{this.Lang}-{this.Reveal}-{Guid.NewGuid():N}";
        }
    }
}
