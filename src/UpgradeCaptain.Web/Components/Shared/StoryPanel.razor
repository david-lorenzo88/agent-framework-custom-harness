@inherits CockpitBase

@* El guion de una parte del paso: objetivo, frases, la lista «Haz» y qué contar. Los prompts y las acciones se lanzan desde ⚡ en el chat. *@
<section class="story">
    <p class="goal">@Md(this.Part.Goal)</p>

    @foreach (Bi line in this.Part.Lines)
    {
        <blockquote class="line-to-say">“@Md(line)”</blockquote>
    }

    <div class="story-grid">
        <div>
            <h4>@T("Haz", "Do")</h4>
            <ol class="do-list">
                @foreach (DoItem item in this.Part.Do)
                {
                    bool done = this.Cockpit.Done.Contains(item.Id);
                    <li class="@(done ? "done" : string.Empty)" @key="item.Id">
                        <button class="check" title="@T("Marcar", "Tick")" @onclick="() => this.Toggle(item.Id)">@(done ? "✓" : string.Empty)</button>
                        <span class="do-text">@Md(item.Text)</span>
                        @if (item.Action != CockpitAction.None)
                        {
                            <span class="do-launch" title="@T("Se lanza desde ⚡ en el chat", "Launch it from ⚡ in the chat")">⚡</span>
                        }
                    </li>
                }
            </ol>
        </div>

        <div>
            <h4>@T("Cuenta", "Tell them")</h4>
            <ul class="talk">
                @foreach (Bi point in this.Part.Talk)
                {
                    <li>@Md(point)</li>
                }
            </ul>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public StepPart Part { get; set; } = default!;

    private void Toggle(string id)
    {
        if (!this.Cockpit.Done.Remove(id))
        {
            this.Cockpit.Done.Add(id);
        }

        this.Cockpit.NotifyNow();
    }
}
