@inherits CockpitBase

@* La conversación en directo: texto del modelo, tools, aprobaciones, el plan y lo que dice el harness. *@
<div class="transcript" data-autoscroll>
    @if (this.Cockpit.Agent.Entries.Count == 0)
    {
        <div class="transcript-empty">
            <div class="empty-glyph">⎈</div>
            <p>@(this.Cockpit.Agent.State == RunState.Off ? T("Monta el agente del paso para empezar.", "Start the step's agent to begin.") : T("Escribe un prompt o usa uno del guion.", "Type a prompt or use one from the script."))</p>
        </div>
    }

    @foreach (TranscriptEntry entry in this.Cockpit.Agent.Entries)
    {
        @switch (entry)
        {
            case UserEntry user:
                <div class="msg msg-user enter" @key="entry.Id"><span class="who">@T("tú", "you")</span><div class="bubble">@user.Text</div></div>
                break;

            case AssistantEntry { Planning: true, Streaming: true } drafting:
                <div class="msg msg-plan-drafting enter" @key="entry.Id">
                    <span class="who">agent</span>
                    <div class="bubble shimmer">🗺️ @T("Redactando el plan", "Drafting the plan")<span class="dots"><i></i><i></i><i></i></span> <small>@drafting.Text.Length</small></div>
                </div>
                break;

            case AssistantEntry assistant:
                <div class="msg msg-agent enter @(assistant.Streaming ? "streaming" : string.Empty)" @key="entry.Id">
                    <span class="who">agent</span>
                    <div class="bubble md">@Markdown.ToHtml(assistant.Text)@if (assistant.Streaming){<span class="caret"></span>}</div>
                </div>
                break;

            case ToolEntry tool:
                <details class="tool tool-@tool.State.ToString().ToLowerInvariant() fam-@ToolText.Family(tool.Name) enter" @key="entry.Id">
                    <summary>
                        <span class="tool-icon">@ToolText.Icon(tool.Name)</span>
                        <code class="tool-summary">@tool.Summary</code>
                        <span class="tool-state">@(tool.State switch
                        {
                            ToolState.Running => "⋯",
                            ToolState.Done => "✓",
                            ToolState.Failed => "✗",
                            ToolState.Denied => "⛔",
                            _ => "⏸",
                        })</span>
                        @if (tool.Duration is { } duration && duration.TotalMilliseconds > 50)
                        {
                            <span class="tool-time">@(duration.TotalSeconds >= 1 ? $"{duration.TotalSeconds:0.0} s" : $"{duration.TotalMilliseconds:0} ms")</span>
                        }
                    </summary>
                    <div class="tool-body">
                        <pre class="args">@ToolText.Pretty(tool.Arguments)</pre>
                        @if (tool.Result is { Length: > 0 } result)
                        {
                            <pre class="result">@result</pre>
                        }
                    </div>
                </details>
                break;

            case ApprovalEntry approval:
                <ApprovalCard Entry="approval" @key="entry.Id" />
                break;

            case PlanEntry plan:
                <PlanCard Entry="plan" @key="entry.Id" />
                break;

            case HarnessEntry harness:
                <div class="harness harness-@harness.Kind.ToString().ToLowerInvariant() enter" @key="entry.Id">
                    <span class="harness-tag">@(harness.Kind is HarnessKind.Loop or HarnessKind.Verification ? T("bucle", "loop") : "harness")</span>
                    <div class="harness-text">@harness.Text</div>
                    @if (harness.Kind == HarnessKind.Green)
                    {
                        <div class="burst" aria-hidden="true">@for (int i = 0; i < 18; i++){<i style="--k:@i"></i>}</div>
                    }
                    @if (harness.Kind == HarnessKind.Parked)
                    {
                        <div class="harness-actions">
                            <button class="btn small btn-owner" @onclick="this.ShowApprovals">👩‍💻 @T("Pestaña Aprobaciones", "Approvals tab")</button>
                            <a class="btn small btn-ghost" href="/maria" target="maria">@T("Ventana de María", "María's window") ↗</a>
                        </div>
                    }
                </div>
                break;

            case NoticeEntry notice:
                <div class="notice notice-@notice.Level.ToString().ToLowerInvariant() enter" @key="entry.Id">@notice.Text</div>
                break;
        }
    }

    @if (this.Cockpit.Agent.State == RunState.Running && !this.Cockpit.Agent.WaitingForOwner)
    {
        <div class="thinking"><span class="dots"><i></i><i></i><i></i></span> @this.Elapsed</div>
    }

    @if (this.Cockpit.Agent.WaitingForOwner)
    {
        <div class="waiting-owner">⏳ @T("Esperando a la propietaria del código… (ventana de María)", "Waiting for the code owner… (María's window)")</div>
    }
</div>

@code {
    private string Elapsed => this.Cockpit.Agent.RunClock is { } clock ? $"{clock.Elapsed.TotalSeconds:0} s" : string.Empty;

    private void ShowApprovals()
    {
        this.Cockpit.ContentTab = "approvals";
        this.Cockpit.NotifyNow();
    }
}
