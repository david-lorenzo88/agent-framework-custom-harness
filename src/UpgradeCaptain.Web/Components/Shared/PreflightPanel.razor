@inherits CockpitBase

@* La lista de T-60 en una tarjeta: lo local se comprueba solo; Azure y el modelo, al pulsar. *@
<section class="preflight panel">
    <header class="panel-head">
        <h3>🛫 @T("Antes de empezar", "Preflight")</h3>
        <div class="actions">
            <button class="btn small btn-ghost" disabled="@this.Cockpit.Preflight.Running" @onclick="this.Cockpit.Preflight.RunLocalAsync">↻ @T("Comprobar", "Check")</button>
            <button class="btn small" disabled="@this.Cockpit.Preflight.Running" @onclick="this.Cockpit.Preflight.RunRemoteAsync"
                    title="@T("Pide un token de Azure y hace una llamada mínima al modelo", "Gets an Azure token and makes one tiny model call")">🔑 Azure + @T("modelo", "model")</button>
        </div>
    </header>

    <ul class="checks">
        @foreach (Check check in this.Cockpit.Preflight.All)
        {
            <li class="check-row state-@check.State.ToString().ToLowerInvariant()" @key="check.Id">
                <span class="check-dot">@(check.State switch { CheckState.Ok => "●", CheckState.Warn => "▲", CheckState.Fail => "✕", CheckState.Running => "◌", _ => "○" })</span>
                <span class="check-title">@T(check.Title)</span>
                <span class="check-detail">@(check.State == CheckState.Pending && check.Remote ? T("al pulsar «Azure + modelo»", "press \"Azure + model\"") : check.Detail)</span>
                @if (check.Hint is { } hint)
                {
                    <span class="check-hint">@T(hint)</span>
                }
            </li>
        }
    </ul>

    <div class="actions stage-actions">
        <button class="btn btn-go" disabled="@(this.Cockpit.Operation is not null)" @onclick='() => this.Cockpit.ResetDemoAsync("clean")'>
            🎬 @T("Preparar el escenario (repo limpio + build)", "Prepare the stage (clean repo + build)")
        </button>
        <button class="btn btn-ghost" disabled="@(this.Cockpit.Operation is not null || this.Cockpit.Reality.Running)" @onclick="this.Cockpit.PackFeedAsync">📦 @T("Empaquetar feed", "Pack feed")</button>
        <a class="btn btn-ghost" href="http://localhost:18888" target="aspire">Aspire ↗</a>
    </div>
</section>
