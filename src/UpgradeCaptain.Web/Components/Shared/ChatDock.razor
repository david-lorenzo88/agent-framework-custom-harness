@inherits CockpitBase
@inject NavigationManager Nav
@inject IJSRuntime JS

@* El chat con el agente: siempre visible, a toda altura, en todas las páginas de la charla. *@
@{
    AgentRunner agent = this.Cockpit.Agent;
    bool busy = agent.State is RunState.Running or RunState.Building;
    int? step = this.Step;
    LauncherSet launchers = Launchers.For(step, step is int s ? this.Cockpit.PartFor(s) : null);
}
<aside class="chat">
    <header class="chat-head">
        <div class="chat-row">
            <span class="chat-title">Upgrade Captain</span>
            <span class="state-dot state-@agent.State.ToString().ToLowerInvariant()" title="@agent.State"></span>
            <span class="muted small">@this.StateText</span>
            <span class="grow"></span>
            @if (agent.LastUsage is { } usage)
            {
                <span class="meter" title="@T("Última llamada al modelo", "Last model call")">in @Tokens(usage.InputTokenCount) · out @Tokens(usage.OutputTokenCount) · @agent.ModelCalls @T("llamadas", "calls")</span>
            }
            <button class="icon-btn" title="@T("Ancho del chat", "Chat width")" @onclick="this.ToggleWidth">@(this.Cockpit.ChatWidth switch { "narrow" => "◂▸ S", "wide" => "◂▸ L", _ => "◂▸ M" })</button>
        </div>
        <div class="chat-row">
            <div class="seg" role="group" aria-label="agent">
                @foreach (AgentStage stage in Stages)
                {
                    <button class="@(agent.Stage == stage ? "on" : string.Empty) @(this.Suggested(stage) ? "suggested" : string.Empty)" disabled="@busy"
                            title="@T("Monta este agente con una sesión nueva", "Build this agent with a new session")" @onclick="() => this.StartAsync(stage)">
                        @AgentRunner.StageName(stage)
                    </button>
                }
            </div>
            @if (agent.Stage is not null && agent.State != RunState.Off)
            {
                <div class="seg mode" role="group" aria-label="mode">
                    <button class="@(agent.Mode == "plan" ? "on" : string.Empty)" disabled="@busy" @onclick='() => agent.SetModeAsync("plan")'>plan</button>
                    <button class="@(agent.Mode == "execute" ? "on exec" : string.Empty)" disabled="@busy" @onclick='() => agent.SetModeAsync("execute")'>execute</button>
                </div>
            }
            @if (step == 1)
            {
                <label class="toggle" title="@T("--context tiny: 16k / 8k, para ver la compactación", "--context tiny: 16k / 8k, to see compaction")">
                    <input type="checkbox" checked="@this._tiny" disabled="@busy" @onchange="e => this._tiny = e.Value is true" />
                    <span>@T("contexto mini", "tiny context")</span>
                </label>
            }
            <span class="grow"></span>
            @if (agent.State is RunState.Running)
            {
                <button class="btn small btn-stop" @onclick="agent.Cancel">⏹ @T("Parar", "Stop")</button>
            }
        </div>
    </header>

    @if (agent.Build is not null)
    {
        <div class="chat-strip">
            <div class="strip-line">
                <span class="strip-label">LoopEvaluators</span>
                @foreach (string evaluator in agent.LoopEvaluators)
                {
                    <span class="chip @(evaluator == "VerifiedCompletionEvaluator" ? "chip-custom" : string.Empty)">@evaluator</span>
                }
                @if (agent.Stage == AgentStage.Step3Pre)
                {
                    <span class="chip chip-missing">@T("+ aquí va el evaluador", "+ the evaluator goes here")</span>
                }
                @if (agent.Services is not null)
                {
                    <span class="grow"></span>
                    <span class="muted small">@T("pide", "requester") <code>@agent.Build.Options.Requester</code></span>
                }
            </div>
            @if (agent.Todos.Count > 0)
            {
                <button class="strip-line strip-toggle" @onclick="() => this._todosOpen = !this._todosOpen">
                    <span class="strip-label">@T("Todos", "Todos")</span>
                    <span class="muted small">@agent.Todos.Count(t => t.IsComplete)/@agent.Todos.Count</span>
                    <span class="grow"></span>
                    <span class="muted">@(this._todosOpen ? "▾" : "▸")</span>
                </button>
                @if (this._todosOpen)
                {
                    <ul class="todos">
                        @foreach (var todo in agent.Todos)
                        {
                            <li class="todo @(todo.IsComplete ? "done" : string.Empty)" @key="todo.Id">
                                <span class="todo-box">@(todo.IsComplete ? "✓" : "○")</span><span>@todo.Title</span>
                            </li>
                        }
                    </ul>
                }
            }
        </div>
    }

    <TranscriptView />

    <footer class="composer">
        @if (this._launcherOpen)
        {
            <div class="popover-backdrop" @onclick="this.CloseLauncher"></div>
            <div class="launcher" role="dialog" aria-label="launcher">
                <header class="launcher-head">
                    <span>⚡ @T(launchers.Title)</span>
                    <button class="icon-btn" @onclick="this.CloseLauncher" title="Esc">✕</button>
                </header>
                <div class="launcher-body">
                    @if (launchers.Prompts.Count > 0)
                    {
                        <h5>@T("Prompts del guion", "Script prompts")</h5>
                        @foreach (PromptChip prompt in launchers.Prompts)
                        {
                            <div class="launch-prompt">
                                <div class="launch-text">
                                    <span class="launch-label">@T(prompt.Label)</span>
                                    <span class="launch-mono">@T(prompt.Text)</span>
                                    @if (prompt.Hint is { } hint)
                                    {
                                        <span class="launch-hint">@Md(hint)</span>
                                    }
                                </div>
                                <div class="launch-buttons">
                                    <button class="btn small btn-ghost" title="@T("Al cuadro de mensaje (o a la respuesta del plan)", "To the message box (or the plan's answer)")" @onclick="() => this.Insert(prompt)">@T("Insertar", "Insert")</button>
                                    <button class="btn small btn-go" disabled="@(agent.State != RunState.Idle)" @onclick="() => this.Send(prompt)">@T("Enviar", "Send") ➤</button>
                                </div>
                            </div>
                        }
                    }
                    @if (launchers.Actions.Count > 0)
                    {
                        <h5>@T("Acciones", "Actions")</h5>
                        <div class="launch-actions">
                            @foreach (DoItem action in launchers.Actions)
                            {
                                <button class="launch-action @(this.Cockpit.Done.Contains(action.Id) ? "done" : string.Empty)" disabled="@Launchers.Disabled(this.Cockpit, action.Action)" @onclick="() => this.RunAsync(action)">
                                    <span class="launch-icon">@Launchers.Icon(action.Action)</span>
                                    <span class="launch-action-text">@Md(action.Text)</span>
                                    @if (this.Cockpit.Done.Contains(action.Id))
                                    {
                                        <span class="launch-done">✓</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                    <h5>@T("Más", "More")</h5>
                    <div class="launch-more">
                        @foreach (DoItem action in launchers.More)
                        {
                            <button class="btn small btn-ghost" disabled="@Launchers.Disabled(this.Cockpit, action.Action)" @onclick="() => this.RunAsync(action)">@Launchers.Icon(action.Action) @T(action.Text)</button>
                        }
                    </div>
                </div>
            </div>
        }

        <button id="launcher-toggle" class="btn launcher-btn @(this._launcherOpen ? "on" : string.Empty)" title="@T("Prompts y acciones del paso (P)", "Prompts and actions of this step (P)")" @onclick="this.ToggleLauncher">⚡</button>
        <textarea id="composer" rows="2" placeholder="@this.Placeholder" disabled="@(agent.State != RunState.Idle)"
                  @bind="this.Cockpit.Draft" @bind:event="oninput"></textarea>
        <button id="composer-send" class="btn btn-go" disabled="@(agent.State != RunState.Idle)" @onclick="this.SendDraft">➤</button>
    </footer>
</aside>

@code {
    private static readonly AgentStage[] Stages = [AgentStage.Step1, AgentStage.Step2, AgentStage.Step3Pre, AgentStage.Step3];
    private bool _tiny;
    private bool _todosOpen = true;
    private bool _launcherOpen;

    /// <summary>El paso de la página: 1–4, 0 en la portada, null en el resto.</summary>
    private int? Step
    {
        get
        {
            string path = this.Nav.ToBaseRelativePath(this.Nav.Uri).Split('?', '#')[0];
            return path.Length == 0 ? 0
                : path.StartsWith("step/", StringComparison.Ordinal) && int.TryParse(path["step/".Length..], out int n) ? n
                : null;
        }
    }

    private bool Suggested(AgentStage stage) => (this.Step, this.Step is int s ? this.Cockpit.PartFor(s) : null) switch
    {
        (1, _) => stage == AgentStage.Step1,
        (2, _) => stage == AgentStage.Step2,
        (3, "3c") => stage == AgentStage.Step3,
        (3, "3b") => stage is AgentStage.Step3Pre or AgentStage.Step3,
        (3, _) => stage == AgentStage.Step3Pre,
        _ => false,
    };

    private string StateText => this.Cockpit.Agent.State switch
    {
        RunState.Off => T("sin agente", "no agent"),
        RunState.Building => T("montando…", "building…"),
        RunState.Running when this.Cockpit.Agent.WaitingForOwner => T("esperando a María", "waiting for María"),
        RunState.Running => T("trabajando…", "working…"),
        RunState.AwaitingUser => T("te toca responder", "your turn to answer"),
        _ => T("listo", "ready"),
    };

    private string Placeholder => this.Cockpit.Agent.State switch
    {
        RunState.Off => T("Monta un agente (botones de arriba) o usa ⚡.", "Build an agent (buttons above) or use ⚡."),
        RunState.Running => T("El agente está trabajando…", "The agent is working…"),
        RunState.AwaitingUser => T("Responde a la tarjeta de arriba.", "Answer the card above."),
        RunState.Building => T("Montando el agente…", "Building the agent…"),
        _ => T("Mensaje (Enter envía, Mayús+Enter salto de línea) · ⚡ prompts del guion", "Message (Enter sends, Shift+Enter new line) · ⚡ script prompts"),
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this.Nav.LocationChanged += this.OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        this._launcherOpen = false;
        _ = this.InvokeAsync(this.StateHasChanged);
    }

    private static string Tokens(long? count) => count is null ? "?" : count >= 1000 ? $"{count / 1000.0:0.#}k" : count.Value.ToString();

    private Task StartAsync(AgentStage stage) => this.Cockpit.StartAgentAsync(stage, this._tiny);

    private void ToggleWidth()
    {
        this.Cockpit.ChatWidth = this.Cockpit.ChatWidth switch { "normal" => "wide", "wide" => "narrow", _ => "normal" };
        this.Cockpit.NotifyNow();
    }

    private void ToggleLauncher() => this._launcherOpen = !this._launcherOpen;

    private void CloseLauncher() => this._launcherOpen = false;

    private async Task Insert(PromptChip prompt)
    {
        this.Cockpit.Draft = T(prompt.Text);
        this._launcherOpen = false;
        this.Cockpit.NotifyNow();
        await this.JS.InvokeVoidAsync("uc.focus", "composer");
    }

    private void Send(PromptChip prompt)
    {
        this._launcherOpen = false;
        this.Cockpit.Draft = string.Empty;
        this.Cockpit.Agent.Send(T(prompt.Text));
    }

    private async Task RunAsync(DoItem action)
    {
        this._launcherOpen = false;
        await Launchers.RunAsync(this.Cockpit, this.JS, action);
    }

    private void SendDraft()
    {
        string text = this.Cockpit.Draft;
        this.Cockpit.Draft = string.Empty;
        this.Cockpit.Agent.Send(text);
    }

    public override void Dispose()
    {
        this.Nav.LocationChanged -= this.OnLocationChanged;
        base.Dispose();
    }
}
