@inherits CockpitBase
@using System.Text.Json

@* El portátil de María (antes T2): las aprobaciones aparcadas por CodeOwnerApprovalAgent, decididas con DecideAsync. *@
@{
    HarnessServices? services = this.Cockpit.Agent.Services;
}
<section class="owner panel">
    <header class="panel-head">
        <h3>👩‍💻 @T("Aprobaciones por propietario", "Code-owner approvals") <small>CODEOWNERS · ApprovalStore</small></h3>
        <div class="decide-as" role="group" aria-label="decide as">
            <span class="muted small">@T("Decidir como", "Decide as")</span>
            @foreach (string handle in Handles)
            {
                <button class="btn small @(this._as == handle ? "active" : string.Empty)" @onclick="() => this._as = handle">@handle</button>
            }
        </div>
    </header>

    @if (services is null)
    {
        <p class="muted">@T("Aparece con el harness a medida (step-3): monta step-3-pre o step-3.", "It shows up with the custom harness (step 3): start step-3-pre or step-3.")</p>
    }
    else
    {
        var approvals = services.Approvals.List().Where(a => a.JobId == this.Cockpit.Agent.JobId).OrderByDescending(a => a.Status == ApprovalStatus.Pending).ThenByDescending(a => a.CreatedAt).ToList();
        @if (approvals.Count == 0)
        {
            <p class="muted">@T("Nada aparcado. Cuando el agente toque Payments, aparece aquí.", "Nothing parked. When the agent touches Payments, it shows up here.")</p>
        }

        @foreach (PendingApproval approval in approvals)
        {
            FileChangePreview? preview = this.PreviewOf(approval, services);
            <article class="card owner-card @(approval.Status == ApprovalStatus.Pending ? "pending" : "answered") @(this._shake == approval.Id ? "shake" : string.Empty)" @key="approval.Id">
                <header>
                    <span class="card-icon">@(approval.Status switch { ApprovalStatus.Approved => "✅", ApprovalStatus.Rejected => "✋", _ => "⏸" })</span>
                    <span class="card-title">@approval.Id</span>
                    <code class="tool-summary">@approval.ToolName · @string.Join(", ", approval.Paths)</code>
                    <span class="badge">@T("propietario", "owner"): @string.Join(", ", approval.Owners)</span>
                    <span class="badge badge-dim">@T("pide", "requested by"): @approval.RequestedBy</span>
                </header>

                @if (preview is not null)
                {
                    <div class="diff">
                        <pre><code>@foreach (DiffLine line in preview.Lines)
{<span class="dl dl-@line.Kind.ToString().ToLowerInvariant()"><span class="dn">@(line.OldNumber?.ToString() ?? string.Empty)</span><span class="dn">@(line.NewNumber?.ToString() ?? string.Empty)</span><span class="dm">@(line.Kind switch { DiffKind.Added => "+", DiffKind.Removed => "−", DiffKind.Gap => "", _ => " " })</span><span class="dt">@line.Text</span></span>
}</code></pre>
                    </div>
                }

                @if (approval.Status == ApprovalStatus.Pending)
                {
                    <div class="actions">
                        <input class="input" @bind="this._reason" @bind:event="oninput" placeholder="@T("Motivo", "Reason")" />
                        <button class="btn btn-go" disabled="@this._busy" @onclick="() => this.DecideAsync(approval, true)">✅ @T("Aprobar como", "Approve as") @this._as</button>
                        <button class="btn btn-stop" disabled="@this._busy" @onclick="() => this.DecideAsync(approval, false)">✋ @T("Rechazar", "Reject")</button>
                    </div>
                }
                else
                {
                    <div class="answer answer-@(approval.Status == ApprovalStatus.Approved ? "yes" : "no")">
                        @(approval.Status == ApprovalStatus.Approved ? T("Aprobada", "Approved") : T("Rechazada", "Rejected")) @T("por", "by") @approval.DecidedBy@(approval.Reason is { } r ? $": «{r}»" : string.Empty)
                    </div>
                }
            </article>
        }

        @if (this._result is { } result)
        {
            <div class="decision-result @(result.Accepted ? "ok" : "refused") enter" @key="this._resultKey">@(result.Accepted ? "✔" : "⛔") @result.Message</div>
        }

        <div class="audit">
            <button class="btn small btn-ghost" @onclick="this.VerifyAudit">🔗 @T("Verificar la auditoría", "Verify the audit log")</button>
            @if (this._audit is { } audit)
            {
                <span class="audit-result @(audit.Ok ? "ok" : "bad")">
                    @(audit.Ok ? T($"✔ Cadena de hashes verificada ({audit.Count} entradas)", $"✔ Hash chain verified ({audit.Count} entries)") : T($"✘ Cadena rota en {audit.BrokenAtSeq}: {audit.Reason}", $"✘ Chain broken at {audit.BrokenAtSeq}: {audit.Reason}"))
                </span>
            }
            <ol class="audit-log">
                @foreach (AuditEntry entry in services.Audit.ReadAll().TakeLast(this.AuditRows).Reverse())
                {
                    <li><span class="ae-event ae-@entry.Event">@entry.Event</span> <span class="muted">@entry.Actor</span> @(entry.ApprovalId is { } id ? id : string.Empty)</li>
                }
            </ol>
        </div>
    }
</section>

@code {
    private static readonly string[] Handles = ["@maria-payments", "@david-lorenzo"];
    private string _as = "@maria-payments";
    private string _reason = string.Empty;
    private bool _busy;
    private ApprovalDecisionResult? _result;
    private int _resultKey;
    private string? _shake;
    private AuditVerification? _audit;

    [Parameter]
    public int AuditRows { get; set; } = 8;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this._reason = T("Revisado: tarifa en km", "Reviewed: fare in km");
    }

    private FileChangePreview? PreviewOf(PendingApproval approval, HarnessServices services)
    {
        try
        {
            var arguments = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(approval.ArgumentsJson)?
                .ToDictionary(p => p.Key, p => (object?)p.Value);
            return approval.Status == ApprovalStatus.Pending ? AgentRunner.Preview(approval.ToolName, arguments, services.RepoDir, services.Policy) : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private async Task DecideAsync(PendingApproval approval, bool approve)
    {
        if (this.Cockpit.Agent.Approvals is not { } owner)
        {
            return;
        }

        this._busy = true;
        try
        {
            // resume: false → si nadie espera (la ejecución se paró), la decisión se aplica en el próximo mensaje,
            // dentro del panel en directo, y no en segundo plano donde no se vería.
            this._result = await owner.DecideAsync(approval.Id, this._as, approve, string.IsNullOrWhiteSpace(this._reason) ? null : this._reason, resume: false);
            this._resultKey++;
            this._shake = this._result.Accepted ? null : approval.Id;
        }
        finally
        {
            this._busy = false;
            this.Cockpit.NotifyNow();
        }
    }

    private void VerifyAudit() => this._audit = this.Cockpit.VerifyAudit();
}
