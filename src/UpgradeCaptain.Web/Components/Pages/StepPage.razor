@page "/step/{Number:int}"
@inherits CockpitBase

@if (this.Step is not { } step)
{
    <p class="muted">@T("No existe ese paso.", "There's no such step.")</p>
    return;
}

<PageTitle>@step.Number · @T(step.Title) · Upgrade Captain</PageTitle>

@{
    string tab = this.CurrentTab;
}
<div class="page step-@step.Number" @key="step.Number">
    <header class="page-header">
        <div class="step-badge">@step.Number</div>
        <div class="page-heading">
            <h1>@T(step.Title) <span class="tagline">@T(step.Tagline)</span></h1>
            <p class="page-goal">@Md(step.Goal)</p>
        </div>
        <div class="step-timing" title="@T("Inicio y duración en el guion", "Start and length in the run-of-show")">
            <span class="timing-start">@($"{(int)step.Start.TotalMinutes}:00")</span>
            <span class="timing-length">@step.Minutes min</span>
        </div>
    </header>

    @if (step.Parts.Count > 1)
    {
        <nav class="parts" role="tablist">
            @foreach (StepPart part in step.Parts)
            {
                <button class="part-chip @(part.Id == this.Part.Id ? "active" : string.Empty)" @onclick="() => this.SelectPart(part.Id)">
                    <b>@part.Id</b> @T(part.Title) <small>@part.Minutes′</small>
                </button>
            }
        </nav>
    }

    <nav class="tabs" role="tablist">
        @foreach (var (id, label) in this.Tabs)
        {
            <button class="tab @(id == tab ? "active" : string.Empty)" role="tab" @onclick="() => this.SelectTab(id)">
                @label
                @if (id == "approvals" && this.PendingApprovals > 0)
                {
                    <span class="tab-badge">@this.PendingApprovals</span>
                }
                @if (id == "reality" && this.Cockpit.Reality.Running)
                {
                    <span class="spinner tiny"></span>
                }
            </button>
        }
    </nav>

    <section class="tab-panel @(tab is "reality" or "approvals" or "hosted" or "evaluator" ? "fill" : string.Empty)" @key="(tab, this.Part.Id)">
        @switch (tab)
        {
            case "script":
                <h2 class="part-title">@T(this.Part.Title) <small>@this.Part.Minutes min</small></h2>
                <StoryPanel Part="this.Part" />
                @if (this.Part.Id == "3b")
                {
                    <PiecesGrid OnSelect="this.ShowSnippet" />
                }
                break;

            case "code":
                <SnippetTabs Items="step.Snippets" @bind-Selected="this._snippet" RevealId="@this.RevealId" />
                break;

            case "reality":
                <RealityPanel />
                break;

            case "approvals":
                <div class="approvals-tab">
                    <p class="muted small">
                        @T("La ventana de María, aquí mismo. Para «otra persona» en otra pantalla:", "María's window, right here. For \"another person\" on another screen:")
                        <a href="/maria" target="maria">María ↗</a>
                    </p>
                    <OwnerPanel AuditRows="10" />
                </div>
                break;

            case "hosted":
                <HostedPanel />
                break;

            case "evaluator":
                <div class="reveal-stage">
                    @if (!this.Cockpit.EvaluatorRevealed)
                    {
                        <div class="reveal-placeholder">
                            <div class="reveal-glyph">✔</div>
                            <p>@T("~30 líneas en un punto de extensión documentado.", "~30 lines in a documented extension point.")</p>
                            <button class="btn btn-go" @onclick="this.RevealEvaluator">✨ @T("Revelar VerifiedCompletionEvaluator", "Reveal VerifiedCompletionEvaluator")</button>
                        </div>
                    }
                    else
                    {
                        <CodeView Id="s3-evaluator" Reveal="true" />
                        @if (!this.Cockpit.WiringRevealed)
                        {
                            <button class="btn btn-go" @onclick="this.RevealWiring">🔌 @T("Enchufarlo en LoopEvaluators", "Plug it into LoopEvaluators")</button>
                        }
                        else
                        {
                            <CodeView Id="s3-wire" Reveal="true" Compact="true" />
                            <button class="btn btn-go" @onclick="this.GoToFixAsync">▶ 3c · @T("Repo after-mechanical-fix + agente step-3", "Repo after-mechanical-fix + step-3 agent")</button>
                        }
                    }
                </div>
                break;

            case "watch":
                <h4>@T("Si algo falla", "If it goes wrong")</h4>
                <ul class="watch-for">
                    @foreach (Bi item in step.WatchFor)
                    {
                        <li>@Md(item)</li>
                    }
                </ul>
                @if (step.Optional.Count > 0)
                {
                    <h4>@T("Opcional, si vas bien de tiempo", "Optional, if ahead of time")</h4>
                    <ul class="optional">
                        @foreach (Bi item in step.Optional)
                        {
                            <li>@Md(item)</li>
                        }
                    </ul>
                }
                break;
        }
    </section>
</div>

@code {
    private string? _snippet;
    private int _number;

    [Parameter]
    public int Number { get; set; }

    private StepContent? Step => StepCatalog.Find(this.Number);

    private StepPart Part => this.Step!.Parts.FirstOrDefault(p => p.Id == this.Cockpit.PartFor(this.Number)) ?? this.Step!.Parts[0];

    private IEnumerable<(string Id, string Label)> Tabs => this.Number switch
    {
        3 =>
        [
            ("script", T("📜 Guion", "📜 Script")),
            ("evaluator", T("✔ Evaluador", "✔ Evaluator")),
            ("code", T("⌗ Código", "⌗ Code")),
            ("reality", T("🧪 Realidad", "🧪 Reality")),
            ("approvals", T("👩‍💻 Aprobaciones", "👩‍💻 Approvals")),
            ("watch", T("⚠ Si algo falla", "⚠ If it goes wrong")),
        ],
        4 =>
        [
            ("script", T("📜 Guion", "📜 Script")),
            ("hosted", "☁ Hosted Agent"),
            ("code", T("⌗ Código", "⌗ Code")),
            ("watch", T("⚠ Si algo falla", "⚠ If it goes wrong")),
        ],
        _ =>
        [
            ("script", T("📜 Guion", "📜 Script")),
            ("code", T("⌗ Código", "⌗ Code")),
            ("reality", T("🧪 Realidad", "🧪 Reality")),
            ("watch", T("⚠ Si algo falla", "⚠ If it goes wrong")),
        ],
    };

    /// <summary>La pestaña de la cabina si existe en este paso (los lanzadores del chat la cambian), si no la primera.</summary>
    private string CurrentTab => this.Tabs.Any(t => t.Id == this.Cockpit.ContentTab) ? this.Cockpit.ContentTab : "script";

    private int PendingApprovals => this.Cockpit.Agent.Services?.Approvals.List()
        .Count(a => a.JobId == this.Cockpit.Agent.JobId && a.Status == ApprovalStatus.Pending) ?? 0;

    private string? RevealId => this.Number == 3 && this.Cockpit.EvaluatorRevealed && this._snippet == "s3-evaluator" ? "s3-evaluator" : null;

    protected override void OnParametersSet()
    {
        if (this._number != this.Number)
        {
            this._number = this.Number;
            this._snippet = null;
            this.Cockpit.ContentTab = "script";
        }
    }

    private void SelectTab(string id)
    {
        this.Cockpit.ContentTab = id;
        this.Cockpit.NotifyNow();
    }

    private void SelectPart(string id)
    {
        this.Cockpit.SetPart(this.Number, id);
        this.Cockpit.ContentTab = "script";
        this.Cockpit.NotifyNow();
    }

    private void ShowSnippet(string id)
    {
        this._snippet = id;
        this.SelectTab("code");
    }

    private void RevealEvaluator()
    {
        this.Cockpit.EvaluatorRevealed = true;
        this.Cockpit.Done.Add("3b.evaluator");
        this.Cockpit.NotifyNow();
    }

    private void RevealWiring()
    {
        this.Cockpit.WiringRevealed = true;
        this.Cockpit.Done.Add("3b.wire");
        this.Cockpit.NotifyNow();
    }

    private async Task GoToFixAsync()
    {
        this.Cockpit.SetPart(3, "3c");
        await this.Cockpit.ResetDemoAsync("after-mechanical-fix");
        this.Cockpit.Done.Add("3c.reset");
        await this.Cockpit.StartAgentAsync(AgentStage.Step3);
        this.Cockpit.Done.Add("3c.start");
        this.Cockpit.ContentTab = "script";
        this.Cockpit.NotifyNow();
    }
}
