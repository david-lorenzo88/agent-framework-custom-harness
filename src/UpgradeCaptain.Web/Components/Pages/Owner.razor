@page "/maria"
@inherits CockpitBase

@* La ventana de María, en otra ventana (o en el móvil): otra persona, otro color. Lo que antes era el terminal T2. *@
<PageTitle>María · @T("aprobaciones", "approvals")</PageTitle>

<div class="owner-page">
    <section class="owner-status panel enter">
        @{
            AgentRunner agent = this.Cockpit.Agent;
            HarnessEntry? last = agent.Entries.OfType<HarnessEntry>().LastOrDefault();
        }
        <div class="owner-who">
            <span class="avatar">M</span>
            <div>
                <strong>María Hernández</strong> <code>@("@maria-payments")</code>
                <p class="muted small">@T("Propietaria de /src/Canarias.Tours.Payments/ según CODEOWNERS", "Owner of /src/Canarias.Tours.Payments/ according to CODEOWNERS")</p>
            </div>
        </div>
        <div class="owner-live">
            <AgentPill />
            @if (agent.WaitingForOwner)
            {
                <span class="waiting-owner inline">⏳ @T("El agente te está esperando", "The agent is waiting for you")</span>
            }
            else if (last is not null)
            {
                <span class="harness-mini harness-@last.Kind.ToString().ToLowerInvariant()">@last.Text</span>
            }
        </div>
    </section>

    <OwnerPanel AuditRows="14" />
</div>
