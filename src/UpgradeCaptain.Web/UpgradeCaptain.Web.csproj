<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    UpgradeCaptain.Web · la cabina de la demo: una web local (Blazor Server) con los cuatro pasos de la charla.
    Cada paso tiene su explicación, el código que se enseña y un panel para ejecutarlo en directo, en inglés o en español.
    Todos los agentes salen de UpgradeCaptainFactory (el mismo código que la consola y el Hosted Agent).
    Sin CDNs: todo lo que carga el navegador está en wwwroot/. Se arranca con scripts/cockpit.sh.
  -->
  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RootNamespace>UpgradeCaptain.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UpgradeCaptain.Core\UpgradeCaptain.Core.csproj" />
    <ProjectReference Include="..\UpgradeCaptain.Harness\UpgradeCaptain.Harness.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Las skills viajan junto al ejecutable: bin/.../skills y bin/.../skills-en -->
    <Content Include="..\..\skills\**\*" LinkBase="skills" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Include="..\..\skills-en\**\*" LinkBase="skills-en" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <!-- Los fragmentos de código que enseña la cabina: bin/.../Snippets -->
    <Compile Remove="Snippets\**" />
    <None Include="Snippets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
