<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UpgradeCaptain.Harness · step-6 · las piezas a medida, enchufadas en los puntos de extensión del HarnessAgent:

      LoopEvaluators      → VerifiedCompletionEvaluator   ("terminado" = compila y pasa los tests)
      AIContextProviders  → RepoStateProvider             (verdad del repo que sobrevive a la compactación)
      DelegatingAIAgent   → CodeOwnerApprovalAgent        (aprueba el propietario del código, no quien pide)
      DelegatingChatClient→ BudgetGuard                   (tope de tokens por sesión)

    Servicios compartidos: RepoVerifier, RepoStateCache, GitCheckpoints, SessionVault, ApprovalStore, AuditLog.
    No depende de UpgradeCaptain.Core: la factoría de Core es quien lo monta todo.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UpgradeCaptain.Harness.Tests" />
  </ItemGroup>

</Project>
