<Project>
  <!--
    Gestión central de paquetes con versiones EXACTAS (PLAN.md §6.1).
    Todos los Microsoft.Agents.AI.* vienen de la misma release: dotnet-1.24.0
    (commit 245d4284a5018b7f446b5eac4d3add1fa5547229). Ver docs/verification-log.md.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Microsoft Agent Framework 1.24.0">
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.24.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Harness" Version="1.24.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Foundry" Version="1.24.0-preview.261006.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Tools.Shell" Version="1.24.0-preview.261006.1" />
    <PackageVersion Include="Microsoft.Agents.AI.LocalCodeAct" Version="1.24.0-preview.261006.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.24.0-preview.261006.1" />
  </ItemGroup>

  <ItemGroup Label="Azure (versiones del Directory.Packages.props de AF en la tag)">
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.AI.Projects" Version="3.0.0-beta.3" />
    <!-- Azure.AI.Projects 3.0.0-beta.3 declara una dependencia a una 3.0.0-alpha no publicada: AF fija esta beta (NU1603). -->
    <PackageVersion Include="Azure.AI.Extensions.OpenAI" Version="3.0.0-beta.3" />
    <PackageVersion Include="Azure.AI.AgentServer.Invocations" Version="1.0.0-beta.7" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions.AI / OpenAI (usados por la consola vendorizada)">
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
  </ItemGroup>

  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
